{
  "manifest_version": 2,
  "name": "Firefox Companion (working name)",
  "version": "0.3.0",
  "description": "Connects the tabs you choose to Claude on this computer.",
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@firefox-companion.invalid",
      "strict_min_version": "160.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity"]
      }
    }
  },
  "permissions": ["tabs", "storage", "activeTab", "nativeMessaging", "cookies", "contextualIdentities"],
  "optional_permissions": ["<all_urls>", "bookmarks", "history", "downloads", "tabGroups"],
  "background": { "page": "background/index.html", "persistent": true },
  "sidebar_action": {
    "default_title": "Firefox Companion",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icon.svg",
    "open_at_install": false
  },
  "browser_action": {
    "default_title": "Firefox Companion",
    "default_icon": "icon.svg",
    "default_area": "navbar"
  },
  "icons": { "48": "icon.svg" }
}
