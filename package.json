{
  "name": "firefox-companion",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build/build.mjs",
    "build:developer": "node build/build.mjs --developer",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:integration": "npm run build && node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:firefox": "npm run build && node test/firefox/run.mjs",
    "test:control": "npm run build && node test/firefox/control.mjs",
    "test:advanced": "npm run build && node test/firefox/advanced.mjs",
    "test:desktop": "npm run build && node test/firefox/desktop.mjs",
    "test:developer": "node test/firefox/developer.mjs",
    "test:companion": "npm run build && node test/firefox/companion.mjs",
    "test:claude": "npm run build && node test/live/claude.mjs",
    "test:chat": "npm run build && node test/live/chat.mjs",
    "test:milestone": "npm run build && node test/live/milestone.mjs"
  }
}
