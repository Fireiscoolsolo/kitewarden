{
  "manifest_version": 2,
  "name": "Kitewarden for Thunderbird",
  "version": "1.0.0",
  "description": "Lets clients on this computer read mail that you share, one message at a time after your approval.",
  "browser_specific_settings": {
    "gecko": { "id": "thunderbird@fireiscoolsolo.github.io", "strict_min_version": "140.0" }
  },
  "permissions": ["accountsRead", "messagesRead", "storage", "nativeMessaging"],
  "background": { "page": "thunderbird/index.html", "persistent": true },
  "browser_action": { "default_title": "Kitewarden", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg" }
}
