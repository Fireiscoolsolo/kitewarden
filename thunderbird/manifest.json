{
  "manifest_version": 2,
  "name": "Companion for Thunderbird (working name)",
  "version": "0.6.0",
  "description": "Lets clients on this computer read mail that you share, one message at a time after your approval.",
  "browser_specific_settings": {
    "gecko": { "id": "mail@firefox-companion.invalid", "strict_min_version": "140.0" }
  },
  "permissions": ["accountsRead", "messagesRead", "storage", "nativeMessaging"],
  "background": { "page": "thunderbird/index.html", "persistent": true },
  "browser_action": { "default_title": "Firefox Companion", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg" }
}
